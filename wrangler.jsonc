{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-report",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sales-report-db",
    },
  ],
  "vars": {
    "APP_ENV": "production",
  },
  "observability": {
    "enabled": true,
  },
}
