{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "plugins": ["typescript", "oxc", "unicorn", "import"],
  "ignorePatterns": ["node_modules/**", "dist/**", ".wrangler/**", "coverage/**"]
}
