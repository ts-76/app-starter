# Zero Trust Write + Access Organizations/Apps Write + Workers Scripts Write + Zone Read を持つaccount-scopedトークン。
# 使い方: pnpm infra:plan / pnpm infra:apply -- --yes
# CLOUDFLARE_API_TOKEN は terraform の cloudflare provider が参照する変数名。
CLOUDFLARE_TERRAFORM_API_TOKEN=op://Cloudflare/builds-api-token/CLOUDFLARE_TERRAFORM_API_TOKEN
CLOUDFLARE_API_TOKEN=op://Cloudflare/builds-api-token/CLOUDFLARE_TERRAFORM_API_TOKEN

# R2 bucket「internal-tools-terraform-state」だけをObject Read & WriteできるS3互換資格情報。
# Cloudflare vaultの「builds-api-token」項目に、同名の2フィールドを作成します。
AWS_ACCESS_KEY_ID=op://Cloudflare/builds-api-token/AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=op://Cloudflare/builds-api-token/AWS_SECRET_ACCESS_KEY
