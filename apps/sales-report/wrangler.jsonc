{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-report",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-19",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
    },
  ],
  "vars": {
    "APP_ENV": "production",
  },
  "env": {
    "staging": {
      "name": "sales-report-staging",
      "workers_dev": false,
      "d1_databases": [
        {
          "binding": "DB",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
        },
      ],
      "vars": {
        "APP_ENV": "staging",
      },
    },
  },
}
