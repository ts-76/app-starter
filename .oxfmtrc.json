{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".wrangler/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "internal-tools-monorepo-cloudflare-plan.md"
  ]
}
