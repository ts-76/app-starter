{
  "name": "internal-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:access": "node --experimental-strip-types scripts/bootstrap-access.ts",
    "deploy:ci": "node --experimental-strip-types scripts/deploy.ts --source github-actions",
    "deploy:builds": "node --experimental-strip-types scripts/deploy.ts --source cloudflare-builds",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "infra:check": "node --experimental-strip-types scripts/infra-config.ts",
    "infra:state:migrate": "op run --env-file .env.terraform.1password -- mise exec -- node --experimental-strip-types scripts/infra-state.ts migrate",
    "infra:plan": "op run --env-file .env.terraform.1password -- mise exec -- node --experimental-strip-types scripts/infra.ts plan",
    "infra:apply": "op run --env-file .env.terraform.1password -- mise exec -- node --experimental-strip-types scripts/infra.ts apply",
    "new:app": "node --experimental-strip-types scripts/new-app.ts",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "secretlint": "secretlint \"**/*\"",
    "test": "vp test",
    "test:watch": "vp test watch",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "vp check && secretlint \"**/*\" && vp test",
    "prepare": "node scripts/install-lefthook-if-git.js"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "latest",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "secretlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.6 <23",
    "pnpm": "11.8.0"
  },
  "packageManager": "pnpm@11.8.0"
}
